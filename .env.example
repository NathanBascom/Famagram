
# ══════════════════════════════════════════════════════════════════════════════
#  Famagram — Configuration
#  Copy this file to .env and fill in the values below, then run:
#    docker compose up -d
# ══════════════════════════════════════════════════════════════════════════════

# ─── Database ─────────────────────────────────────────────────────────────────
# Pick any username and a strong password for the database.
POSTGRES_USER=famagram
POSTGRES_PASSWORD=change_me_strong_password

# ─── Security ─────────────────────────────────────────────────────────────────
# Random secret used to sign login sessions.
# Generate one by running:  node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Or use any long random string (64+ characters).
SESSION_SECRET=replace_with_a_very_long_random_string_at_least_64_characters

# Encryption key for all stored photos and videos (AES-256).
# Generate one by running:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ⚠️  BACK THIS UP — losing it means losing access to all media permanently.
ENCRYPTION_KEY=replace_with_64_character_hex_string

# ─── Authentication ───────────────────────────────────────────────────────────
# Choose how users log in:
#   local  → email + password (easiest, no external setup needed)
#   google → Google OAuth2 (requires a Google Cloud project — see below)
AUTH_MODE=local

# ─── Default Admin Account ────────────────────────────────────────────────────
# Only used with AUTH_MODE=local.
# This account is created automatically the first time the app starts.
# ⚠️  Change the password after your first login!
ADMIN_EMAIL=admin@example.com
ADMIN_NAME=Admin
ADMIN_PASSWORD=ChangeMe123!

# ─── Google OAuth2 ────────────────────────────────────────────────────────────
# Only fill these in if AUTH_MODE=google.
# Steps:
#   1. Go to https://console.cloud.google.com/
#   2. Create a project → APIs & Services → Credentials
#   3. Create an OAuth 2.0 Client ID (Web application)
#   4. Add this as an Authorized Redirect URI:
#        http://YOUR_SERVER_IP_OR_DOMAIN/api/auth/google/callback
#   5. Paste the Client ID and Secret below.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost/api/auth/google/callback

# ⚠️  Super-admin for Google OAuth mode:
# When this Google account logs in for the first time it will automatically
# be granted admin access and be approved, even without an invite.
GOOGLE_ADMIN_EMAIL=

# ─── Media Export ─────────────────────────────────────────────────────────────
# Set this to enable the "Export all media" feature in Admin Panel.
# Admins must enter this password to trigger a ZIP download of all photos/videos.
# Leave blank to disable the export feature entirely.
EXPORT_PASSWORD=

# ─── App URL ──────────────────────────────────────────────────────────────────
# The address users will use to access the app.
#   Local machine:  http://localhost
#   Home server:    http://192.168.1.x  (your server's local IP)
#   Public domain:  https://photos.yourfamily.com
FRONTEND_URL=http://localhost
