# ══════════════════════════════════════════════════════════════════════════════
#  Famagram — Configuration
#  Copy this file to .env and fill in the values below, then run:
#    docker compose up -d
# ══════════════════════════════════════════════════════════════════════════════

# ─── Database ─────────────────────────────────────────────────────────────────
# Pick any username and a strong password for the database.
POSTGRES_USER=famagram
POSTGRES_PASSWORD=change_me_strong_password

# ─── Security ─────────────────────────────────────────────────────────────────
# Random secret used to sign login sessions.
# Generate one by running:  node -e "console.log(require('crypto').randomBytes(64).toString('hex'))" 
# If you get an error, try: openssl rand -hex 64
# Or use any long random string (64+ characters).
SESSION_SECRET=replace_with_a_very_long_random_string_at_least_64_characters

# Encryption key for all stored photos and videos (AES-256).
# Generate one by running:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If you get an error, try: openssl rand -hex 32
# ⚠️  BACK THIS UP — losing it means losing access to all media permanently.
ENCRYPTION_KEY=replace_with_64_character_hex_string

# Whether the login session cookie is marked Secure (only sent over HTTPS).
# Leave unset to default to "true" in production. Set to "false" only for a
# plain-HTTP local/LAN deployment; set to "true" if you terminate TLS at a
# reverse proxy in front of this app even though APP_URL itself is http://.
# COOKIE_SECURE=true

# ─── Authentication ───────────────────────────────────────────────────────────
# Choose how users log in:
#   local  → email + password (easiest, no external setup needed)
#   google → Google OAuth2 only (requires a Google Cloud project — see below)
#   hybrid → Both Google OAuth2 and email/password (fill in GOOGLE_* vars too)
AUTH_MODE=local

# ─── Default Admin Account ────────────────────────────────────────────────────
# Only used with AUTH_MODE=local.
# This account is created automatically the first time the app starts.
# ⚠️  Change the password after your first login!
ADMIN_EMAIL=admin@example.com
ADMIN_NAME=Admin
ADMIN_PASSWORD=REPLACE_WITH_SECRET

# ─── App URL & Port ───────────────────────────────────────────────────────────
# APP_URL: full public URL where your app is accessible — scheme + host + port if non-standard.
#   No trailing slash.
#   Local machine:   http://localhost
#   Home server:     http://192.168.1.100
#   Custom port:     http://192.168.1.100:8088
#   Public domain:   https://photos.example.com
#
# PORT: the port Docker maps on the host machine (default 80).
#   If you use a non-standard port, set it here AND include it in APP_URL.
#   Example:  APP_URL=https://photos.example.com:8088  and  PORT=8088
APP_URL=http://localhost
PORT=80

# ─── Google OAuth2 ────────────────────────────────────────────────────────────
# Only fill these in if AUTH_MODE=google or AUTH_MODE=hybrid.
# Steps:
#   1. Go to https://console.cloud.google.com/
#   2. Create a project → APIs & Services → Credentials
#   3. Create an OAuth 2.0 Client ID (Web application)
#   4. Add this as an Authorized Redirect URI:
#        {APP_URL}/api/auth/google/callback
#        e.g. https://photos.example.com:8088/api/auth/google/callback
#   5. Paste the Client ID and Secret below.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ⚠️  Super-admin for Google OAuth mode:
# When this Google account logs in for the first time it will automatically
# be granted admin access and be approved, even without an approval.
GOOGLE_ADMIN_EMAIL=

# ─── Media Export ─────────────────────────────────────────────────────────────
# Set this to enable the "Export all media" feature in Admin Panel.
# Admins must enter this password to trigger a ZIP download of all photos/videos.
# Leave blank to disable the export feature entirely.
EXPORT_PASSWORD=

# ─── Push Notifications (optional) ────────────────────────────────────────────
# Lets users subscribe to be notified when specific other users post.
# Generate a keypair with:  npx web-push generate-vapid-keys
# Leave both blank to disable push notifications entirely — the rest of the app
# works normally without them.
# ⚠️  VAPID_PRIVATE_KEY is a secret — never share it or commit it.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact address push services may use to reach you about this app (required by
# the Web Push protocol when the above keys are set). A mailto: or https: URL.
VAPID_SUBJECT=mailto:admin@example.com
