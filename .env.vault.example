# ══════════════════════════════════════════════════════════════════════════════
#  Famagram — Vault deployment config
#  Used with: docker compose -f docker-compose.vault.yml --env-file .env.vault up -d
#
#  All SECRET values (DB password, session secret, encryption key, Google
#  OAuth credentials, admin credentials, export password) live in Vault —
#  see docker-compose.vault.yml for the one-time Vault setup steps.
#  This file only holds non-secret settings plus how to reach Vault.
# ══════════════════════════════════════════════════════════════════════════════

# ── Vault connection ───────────────────────────────────────────────────────────
VAULT_ADDR=<https://vault.example.com:8200>
# Leave blank unless you use Vault namespaces (Vault Enterprise)
VAULT_NAMESPACE=
# KV v2 path holding the famagram secret (see setup steps in docker-compose.vault.yml)
VAULT_SECRET_PATH=secret/data/famagram

# ── App URL / port ─────────────────────────────────────────────────────────────
#   local machine  → http://localhost
#   home server    → http://192.168.1.x
#   public domain  → https://photos.example.com
APP_URL=http://localhost
PORT=80

# ── Authentication mode ────────────────────────────────────────────────────────
#   local  → email + password login (default)
#   google → Google OAuth2 login only
#   hybrid → both
AUTH_MODE=local

# ── Display name for the auto-created admin account ───────────────────────────
ADMIN_NAME=Admin

# ── Session cookie Secure flag ─────────────────────────────────────────────────
# Leave unset to default to "true" (this file is only used in production).
# COOKIE_SECURE=true
